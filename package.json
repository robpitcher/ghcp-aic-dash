{
  "name": "ghcp-aic-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Self-service GitHub Copilot AI credit dashboard scoped to the signed-in developer.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:issueops-action": "ncc build .github/actions/budget-issueops/src/index.ts -o .github/actions/budget-issueops/dist --minify --transpile-only --license licenses.txt",
    "typecheck:issueops-action": "tsc -p tsconfig.issueops-action.json --noEmit",
    "check:issueops-action": "npm run typecheck:issueops-action && npm run build:issueops-action && node scripts/check-issueops-action.mjs",
    "issueops:setup": "tsx scripts/issueops-setup.ts",
    "issueops:doctor": "tsx scripts/issueops-doctor.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "eslint": {
      "minimatch": {
        "brace-expansion": "^1.1.18"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "^5.0.9"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "js-yaml": "^4.3.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
