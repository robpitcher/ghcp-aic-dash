# ─────────────────────────────────────────────────────────────────────────────
# AI Credit Dashboard — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity: GitHub App (proves the developer's login ONLY) ─────────────────
# This file configures the real, connected app. Demo mode is not set here: it
# is opt-in at the command line with `docker compose --profile demo up --build`
# (or `$env:DEMO_ENV = "true"` for a bare `npm run dev`), and it ignores every
# value in this file.

# Create a GitHub App at https://github.com/settings/apps (register it under
# your organization/enterprise so it's "internal" — only enterprise members can
# sign in). Set the callback URL to:  <APP_BASE_URL>/api/auth/github/callback
# No account permissions are required (login + id are public profile fields),
# disable webhooks, and do NOT enable "Request user authorization during
# installation" — no installation is needed for sign-in.
# The user access token is read once (to learn login + id) and then discarded.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# HMAC-SHA256 signing key for the identity session cookie.
# Generate a strong random value, e.g.:  openssl rand -hex 32
SESSION_SECRET=

# ── Data access: privileged enterprise billing token (SERVER-SIDE ONLY) ──────
# A classic PAT with:  manage_billing:copilot (read) and read:enterprise.
# This is the only credential that can read usage; it is never sent to the
# browser. The backend forces the query to the signed-in developer's own
# login, so it can never read anyone else's data. The same token (already
# scoped read:enterprise) is reused, read-only, to verify enterprise membership
# at sign-in — see REQUIRE_ENTERPRISE_MEMBERSHIP below.
GITHUB_BILLING_TOKEN=

# Your enterprise slug (the value in github.com/enterprises/<slug>).
GITHUB_ENTERPRISE_SLUG=

# Billing scope. MVP supports only `enterprise`; `org` is reserved for later.
GITHUB_BILLING_SCOPE=enterprise

# Whether sign-in requires verified membership in the GitHub Enterprise above.
# Defaults to true (secure by default) and fails CLOSED — if the membership
# lookup itself errors, sign-in is denied rather than let through. Set to
# `false` only for local dev/testing without an enterprise-scoped billing
# token; never in production.
REQUIRE_ENTERPRISE_MEMBERSHIP=true

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin used to build OAuth redirect URIs (no trailing slash).
# Locally this is http://localhost:3000; in production set it to the real URL.
APP_BASE_URL=http://localhost:3000

# Optional: comma-separated allowlist of admin logins (reserved for future
# admin / manager roles). Leave empty for the developer-only MVP.
ADMIN_LOGINS=

# Optional IssueOps destination for self-service budget increase requests.
# Must be an exact OWNER/REPO value. No GitHub write token is needed: the
# dashboard opens a prefilled issue for the signed-in developer to review.
# BUDGET_REQUEST_REPOSITORY=your-org/budget-requests

# ── Build ────────────────────────────────────────────────────────────────────
# The Docker build reuses your user-level npm configuration (`~/.npmrc`)
# automatically, so an internal registry needs no setting here. Set
# NPM_CONFIG_USERCONFIG instead if that file lives elsewhere, or to `./.npmrc`
# if you have none.
#
# Optional: force a specific npm registry for the Docker build, overriding the
# configuration above. Include the trailing slash.
# NPM_REGISTRY=
